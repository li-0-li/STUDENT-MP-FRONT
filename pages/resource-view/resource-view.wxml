<!-- 资源查看 —— 原型：ui-prototype/mp/resource-view.html -->
<!-- 数据：表 3-2 课程详情（周目录）/ 表 3-4 资源列表（weekNum 筛选） -->
<view class="page-resource-view">

  <!-- 周次筛选（表 3-2 周目录） -->
  <scroll-view scroll-x class="rv-week-scroll">
    <view class="rv-week-row">
      <view wx:for="{{weekChips}}" wx:key="num"
            class="rv-week-chip {{item.active ? 'active' : ''}}"
            bindtap="switchWeek" data-week="{{item.num}}">{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 资源列表（表 3-4） -->
  <view wx:if="{{resources.length}}" class="card">
    <text class="small muted">共 {{resources.length}} 个资源</text>
    <view wx:for="{{resources}}" wx:key="resourceId"
          class="set-row {{current.resourceId == item.resourceId ? 'on' : ''}}"
          bindtap="onResourceTap" data-id="{{item.resourceId}}">
      <view class="rv-res-main">
        <text>{{item.icon}} {{item.fileName}}</text>
        <text class="small muted">{{item.typeLabel}}{{item.meta ? ' · ' + item.meta : ''}}{{item.savedPath ? ' · 已下载' : ''}}</text>
      </view>
      <view class="badge {{item.indexBadge}}">{{item.indexText}}</view>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="empty">
    <view class="empty-icon">📂</view>
    <view class="small">{{currentWeek ? '第' + currentWeek + '周' : '本课程'}}暂无资源</view>
  </view>

  <!-- 当前资源查看器 -->
  <block wx:if="{{current}}">
    <view class="card">
      <view class="row">
        <view class="icon-box">{{current.icon}}</view>
        <view class="rv-brief">
          <text class="rv-title">{{current.fileName}}</text>
          <text class="small muted">{{current.typeLabel}}{{current.meta ? ' · ' + current.meta : ''}}</text>
        </view>
      </view>
    </view>

    <!-- 视频：video 组件播放（已下载用本地文件，离线可用） -->
    <block wx:if="{{current.fileType == 'video'}}">
      <view class="card rv-video-card">
        <video class="rv-video-real" src="{{current.savedPath || fileBase + current.fileUrl}}"
               controls show-center-play-btn object-fit="contain"></video>
        <view wx:if="{{current.savedPath}}" class="small muted mt4">▶ 正在播放本地文件（离线可用）</view>
      </view>
    </block>

    <!-- 图片：image 组件真实显示（已下载用本地文件） -->
    <block wx:elif="{{current.fileType == 'image'}}">
      <view class="card center">
        <image class="rv-img-real" src="{{current.savedPath || fileBase + current.fileUrl}}" mode="widthFix"
               bindtap="previewImage" data-url="{{current.savedPath || fileBase + current.fileUrl}}"></image>
      </view>
    </block>

    <!-- 文档/表格：点击预览（openDocument）；txt 在卡片内展示文本 -->
    <block wx:elif="{{current.fileType == 'doc' || current.fileType == 'table'}}">
      <view class="card center rv-doc-hint" bindtap="openCurrent"
            wx:if="{{textResourceId != current.resourceId}}">
        <view class="icon-box" style="width:96rpx;height:96rpx;font-size:48rpx;">📄</view>
        <view class="small mt8">点击打开文档（{{current.fileName}}）</view>
        <view class="small muted mt4">在线预览 · 也可用下方按钮下载到本地离线查看</view>
      </view>
      <scroll-view scroll-y class="card" wx:else style="max-height:560rpx;">
        <text user-select style="font-size:26rpx;line-height:1.8;word-break:break-all;">{{textContent}}</text>
      </scroll-view>
    </block>

    <!-- 题库：点击拉取题库内容展示（作答归 M-C 模块） -->
    <block wx:elif="{{current.fileType == 'quiz'}}">
      <view class="card center rv-doc-hint" bindtap="openCurrent"
            wx:if="{{quizResourceId != current.resourceId}}">
        <view class="icon-box" style="width:96rpx;height:96rpx;font-size:48rpx;">📝</view>
        <view class="small mt8">点击预览题库内容（{{current.fileName}}）</view>
        <view class="small muted mt4">作答由作业模块（M-C）提供</view>
      </view>
      <view class="card" wx:else>
        <view wx:for="{{quizQuestions}}" wx:key="idx" class="set-col" style="padding:12rpx 0;">
          <text>{{item.idx}}. {{item.stem}}</text>
          <text wx:for="{{item.options}}" wx:for-item="opt" wx:key="key"
                class="small muted" style="padding-left:32rpx;line-height:1.8;">{{opt.key + 1}}. {{opt.text}}</text>
        </view>
      </view>
    </block>

    <!-- 下载按钮：已下载则变为打开本地文件 -->
    <view class="btn btn-outline btn-block mt12" bindtap="onDownloadTap">
      {{current.savedPath ? '📂 已下载 · 点击打开本地文件' : '⬇ 下载资源'}}
    </view>
  </block>
</view>
