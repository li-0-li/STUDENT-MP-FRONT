/* 随堂测试 · 答题情况 —— 全局 token 与 .card/.btn/.row/.small/.muted/.empty 见 app.wxss */

/* 成绩 hero：teal 渐变深底 */
.res-hero {
  margin: 0 24rpx 16rpx;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--brand-600) 0%, var(--brand-700) 100%);
  color: #fff;
  text-align: center;
}
.res-hero-title { font-size: 28rpx; font-weight: 600; opacity: 0.92; }
.res-hero-acc { font-size: 72rpx; font-weight: 800; line-height: 1.2; margin-top: 8rpx; }
.res-hero-pct { font-size: 30rpx; font-weight: 700; margin-left: 4rpx; opacity: 0.9; }
.res-hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 4rpx; }
.res-grade {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  font-weight: 700;
}

/* 答题概览：圆角 chips 网格 */
.res-sec-title { font-size: 28rpx; font-weight: 700; margin-bottom: 24rpx; }
.res-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.res-chip {
  width: 72rpx; height: 72rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700;
  font-size: 28rpx;
  box-sizing: border-box;
}
.res-chip.ok { background: var(--success); color: #fff; }
.res-chip.bad { background: var(--error); color: #fff; }
.res-demo { width: 28rpx; height: 28rpx; border-radius: 8rpx; }
.res-legend { display: flex; gap: 48rpx; margin-top: 24rpx; }

/* 操作区：主操作 teal 实底，次操作降级为文字链 */
.res-actions {
  margin: 8rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.res-history-link {
  text-align: center;
  color: var(--brand-600);
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 0;
}
