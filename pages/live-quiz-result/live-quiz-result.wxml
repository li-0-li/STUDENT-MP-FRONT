<!-- 随堂测试 · 答题情况：成绩 hero（渐变深底）+ 逐题 chips 网格
     2026-11-25 UI 重设计；data 绑定与事件（goDetail/goFirstDetail/goHistory）不变 -->
<view class="page">
  <view wx:if="{{loading}}" class="card"><view class="empty"><view class="empty-icon">⏳</view>加载中…</view></view>

  <block wx:else>
    <!-- 成绩 hero：teal 渐变深底白字 + 档位徽章 -->
    <view class="res-hero">
      <view class="res-hero-title">{{title}}</view>
      <view class="res-hero-acc">{{accuracy}}<text class="res-hero-pct">%</text></view>
      <view class="res-hero-sub">正确率 · 做对 {{correctCount}}/{{total}} 题</view>
      <view class="res-grade">{{accuracy >= 80 ? '优秀' : (accuracy >= 60 ? '良好' : '继续努力')}}</view>
    </view>

    <!-- 答题概览：逐题 chips（对=绿 / 错=红，点击进该题详情） -->
    <view class="card">
      <view class="res-sec-title">答题概览</view>
      <view class="res-grid">
        <view wx:for="{{answers}}" wx:key="seq"
          class="res-chip {{item.correct ? 'ok' : 'bad'}}"
          bindtap="goDetail" data-idx="{{index}}">{{item.seq}}</view>
      </view>
      <view class="res-legend">
        <view class="row" style="gap: 8rpx;"><view class="res-chip ok res-demo"></view><text class="small muted">做对</text></view>
        <view class="row" style="gap: 8rpx;"><view class="res-chip bad res-demo"></view><text class="small muted">做错</text></view>
      </view>
    </view>

    <!-- 操作区（全局按钮体系） -->
    <view class="res-actions">
      <view class="btn btn-primary btn-block" bindtap="goFirstDetail">查看逐题解析</view>
      <view class="res-history-link" bindtap="goHistory">历史测试 ›</view>
    </view>
  </block>
</view>
