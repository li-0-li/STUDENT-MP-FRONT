/* 随堂测试 · 单题详情 —— 全局 token 与 .card/.badge/.empty/.between 见 app.wxss */

.detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 顶部：细进度条 + 题号行 */
.detail-head { padding: 20rpx 24rpx 8rpx; }
.detail-progress {
  height: 10rpx;
  background: var(--bg-soft);
  border-radius: 999rpx;
  overflow: hidden;
}
.detail-progress-fill {
  display: block;
  height: 100%;
  background: var(--brand-600);
  border-radius: 999rpx;
  transition: width 0.24s ease;
}
.detail-head-row { margin-top: 16rpx; }
.detail-title { display: flex; align-items: center; gap: 12rpx; font-weight: 700; font-size: 30rpx; }
.detail-nav {
  color: var(--brand-600);
  font-size: 26rpx;
  padding: 8rpx 12rpx;
  min-width: 120rpx;
  text-align: center;
}
.detail-nav.placeholder { visibility: hidden; }

.detail-swiper { flex: 1; height: 0; }
.detail-scroll { height: 100%; }

/* 题干 */
.detail-content { font-size: 30rpx; font-weight: 600; line-height: 1.6; color: var(--ink-900); }

/* 选项三分态：正确=success / 我的错选=error / 未涉及=中性 */
.detail-options { display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; }
.detail-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  position: relative;
}
.detail-option.right { border-color: var(--success); background: rgba(22, 163, 74, 0.08); }
.detail-option.mine:not(.right) { border-color: var(--error); background: rgba(220, 38, 38, 0.06); }
.detail-op-key {
  width: 44rpx; height: 44rpx;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--bg-soft);
  color: var(--ink-600);
  font-weight: 700;
  font-size: 24rpx;
}
.detail-option.right .detail-op-key { background: var(--success); color: #fff; }
.detail-option.mine:not(.right) .detail-op-key { background: var(--error); color: #fff; }
.detail-op-text { flex: 1; font-size: 28rpx; line-height: 1.5; }
.detail-tag { flex-shrink: 0; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 999rpx; }
.mine-tag { color: var(--error); background: rgba(220, 38, 38, 0.1); }
.right-tag { color: var(--success); background: rgba(22, 163, 74, 0.1); }

/* 我的答案 vs 正确答案：双列对照 */
.detail-verdict {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
.v-ok { background: rgba(22, 163, 74, 0.08); }
.v-bad { background: rgba(220, 38, 38, 0.06); }
.detail-verdict-cols { display: flex; align-items: stretch; gap: 24rpx; }
.detail-verdict-cell { flex: 1; min-width: 0; }
.detail-verdict-divider { width: 1rpx; background: rgba(0, 0, 0, 0.08); flex-shrink: 0; }
.detail-verdict-label { font-size: 22rpx; color: var(--ink-500); margin-bottom: 8rpx; }
.detail-verdict-value {
  font-size: 30rpx;
  font-weight: 700;
  word-break: break-all;
  line-height: 1.4;
}
.v-ok .detail-verdict-value { color: var(--success); }
.v-bad .detail-verdict-value { color: var(--error); }
.detail-verdict-badge { margin-top: 20rpx; }

/* 解析卡：brand 浅底 + 标签头 */
.detail-analysis-card {
  margin: 16rpx 24rpx 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: var(--brand-50);
  border: 1rpx solid var(--brand-100);
}
.detail-analysis-head { font-size: 24rpx; font-weight: 700; color: var(--brand-700); margin-bottom: 12rpx; }
.detail-analysis {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink-900);
  white-space: pre-wrap;
  word-break: break-all;
}
