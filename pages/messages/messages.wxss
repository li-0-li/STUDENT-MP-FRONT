/* 消息通知 —— 通知/会话 tab / 会话条目 / 聊天详情；.card/.pilltabs/.empty/.chat-msg 等见 app.wxss */

/* 顶部 通知 / 会话 切换 tab 通栏 */
.top-tabs { margin: 24rpx 24rpx 16rpx; }
.top-tabs .pill { flex: 1; }

/* 消息条目（通知 + 会话共用头像样式） */
.msg { display: flex; gap: 20rpx; align-items: flex-start; }
.msg-av {
  width: 84rpx;
  height: 84rpx;
  flex: none;
  border-radius: 22rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.msg-av-sys { background: #64748b; font-size: 36rpx; }
/* 未读红点 */
.msg-dot {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: var(--error);
  border: 4rpx solid #fff;
  box-sizing: border-box;
}
/* 会话未读数（带数字） */
.msg-dot-num {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #fff;
  font-weight: 700;
  padding: 0 6rpx;
}
.msg-mid { flex: 1; min-width: 0; }
.msg-name { font-size: 28rpx; font-weight: 600; }
.msg-name-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.msg-text2 {
  color: var(--ink-500);
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 会话条目（原型 .conv：白底分隔，非卡片） */
.conv {
  display: flex;
  gap: 22rpx;
  align-items: center;
  padding: 22rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--border);
}
.conv:active { background: var(--bg-soft); }
.conv-time { flex: none; }
.conv-last {
  color: var(--ink-500);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.msg-end { padding: 24rpx 0 48rpx; }

/* 发起新对话悬浮按钮（原型 .fab，仅学生会话页显示） */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 64rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--brand-600);
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(13, 148, 136, 0.4);
  z-index: 60;
}

/* 聊天详情浮层（原型 .chat-view，静态演示 TODO M-E） */
.chat-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-soft);
  display: flex;
  flex-direction: column;
  z-index: 300;
}
.chat-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--border);
  flex: none;
}
.chat-back {
  font-size: 52rpx;
  line-height: 1;
  color: var(--ink-600);
  padding: 4rpx 12rpx;
}
.chat-head-mid { flex: 1; min-width: 0; }
.chat-head-name { font-size: 30rpx; font-weight: 700; }
/* scroll-view 竖向滚动必须显式设高（flex:1 对 scroll-view 不生效），
   230rpx ≈ 顶栏 114 + 输入栏 105 + 余量，另减底部安全区 */
.chat-body {
  height: calc(100vh - 230rpx - env(safe-area-inset-bottom));
  padding: 24rpx;
  box-sizing: border-box;
}
.chat-bub-sys {
  background: var(--bg-soft);
  color: var(--ink-500);
  font-size: 24rpx;
  text-align: center;
  margin: 12rpx auto 28rpx;
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  width: fit-content;
}
.chat-tm { font-size: 20rpx; opacity: 0.65; margin-top: 6rpx; text-align: right; }
.chat-foot {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid var(--border);
  flex: none;
  align-items: center;
}
.chat-foot .input {
  flex: 1;
  border-radius: 999rpx;
  background: var(--bg-soft);
  border-color: transparent;
}

/* 通知分组标题（课程名 / 系统通知） */
.notice-sec-title {
  padding: 20rpx 32rpx 8rpx;
  font-weight: 600;
}

/* 会话行名称区：置顶/免打扰角标 + 名称同行 */
.msg-name-row { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.conv-flag { font-size: 24rpx; flex: none; }

/* 课程文件夹行（通知 tab）：课程名 + 未读红点 + 跳转箭头 */
.notice-folder {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  margin: 0 24rpx 16rpx;
}
.notice-folder-icon { font-size: 40rpx; flex: none; }
.notice-folder-name { font-size: 30rpx; font-weight: 600; color: var(--ink-700); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.notice-folder-dot { position: static; flex: none; }
.notice-folder-arrow { font-size: 40rpx; color: var(--ink-300); flex: none; }

/* ============ 期3：聊天增强（撤回/转发/图片/文件/搜索/历史） ============ */

/* 头部操作位（搜索 / 群菜单） */
.chat-head-act {
  font-size: 36rpx;
  color: var(--ink-600);
  padding: 8rpx 4rpx;
  flex: none;
  line-height: 1;
}

/* ============ 期3修订：撤回系统提示行（居中/灰色/小字/无气泡，群聊私聊同款） ============ */
.chat-msg-sys-row {
  width: 100%;
  text-align: center;
  padding: 4rpx 0;
}
.chat-recalled-sys {
  font-size: 22rpx;
  color: var(--ink-400);
  text-align: center;
}

/* 视频气泡（内联播放） */
.chat-video {
  width: 400rpx;
  height: 300rpx;
  border-radius: 16rpx;
  display: block;
  background: #000;
}

/* 图片气泡 */
.chat-bub-media { padding: 6rpx; background: transparent; }
.chat-img {
  width: 320rpx;
  height: 320rpx;
  border-radius: 16rpx;
  display: block;
  background: var(--bg-soft);
}

/* 文件卡片气泡 */
.chat-bub-file {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 320rpx;
}
.chat-file-icon { font-size: 48rpx; flex: none; }
.chat-file-info { flex: 1; min-width: 0; }
.chat-file-name {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

/* 输入栏「+」（发图片 / 发文件） */
.chat-plus {
  font-size: 52rpx;
  font-weight: 300;
  color: var(--ink-600);
  line-height: 1;
  padding: 0 4rpx;
  flex: none;
}
