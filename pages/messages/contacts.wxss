/* 选联系人（建群/私聊）：课程横滑条 + 花名册 + 建群底栏 */
.course-bar {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 24rpx 8rpx;
  background: #fff;
}
.course-pill {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--bg-soft);
  color: var(--ink-500);
  font-size: 26rpx;
  margin-right: 16rpx;
}
.course-pill.on { background: var(--primary, #0d9488); color: #fff; }

.search-row { padding: 20rpx 24rpx; background: #fff; }
.search-input { border-radius: 999rpx; background: var(--bg-soft); border-color: transparent; padding: 14rpx 28rpx; }

.stu-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--border);
  padding: 22rpx 32rpx;
}
.stu-row.on { background: rgba(13, 148, 136, 0.06); }
.stu-av {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--primary, #0d9488);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.stu-mid { flex: 1; min-width: 0; }
.stu-name { font-size: 30rpx; color: var(--ink-700); }
.stu-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 44rpx;
  flex: none;
}
.stu-check.on { background: var(--primary, #0d9488); border-color: var(--primary, #0d9488); }
.stu-check.hidden { visibility: hidden; }
.list-end { padding: 32rpx 0; }

/* 邀请模式（2026-11-24）：已在群的人整行灰显不可选 */
.stu-disabled { opacity: 0.45; }
.stu-ingrp { flex: none; margin-left: 16rpx; }

/* 邀请模式（2026-11-24 口径B）：搜索式选人 */
.stu-disabled { opacity: 0.45; }
.stu-ingrp { flex: none; margin-left: 16rpx; }
.invite-tip { padding: 0 32rpx 8rpx; }

/* 结果卡片右侧「添加」按钮与身份标签 */
.stu-add-btn {
  flex: none;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--primary, #0d9488);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}
.stu-tag {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.tag-student { background: rgba(13, 148, 136, 0.1); color: var(--primary, #0d9488); }
.tag-teacher { background: rgba(245, 158, 11, 0.14); color: #b45309; }

/* 已选横滑栏（2026-11-24）：头像右上角红叉取消、头像下方姓名，横向滑动 */
.group-foot.foot-col { flex-direction: column; align-items: stretch; gap: 16rpx; } /* 提特异性防被 .group-foot align-items:center 覆盖 */
.group-foot .foot-row { width: 100%; display: flex; align-items: center; justify-content: space-between; }
.foot-row .btn, .foot-btn { margin-left: auto; flex: none; } /* 2026-11-25 按钮强制最右（专用类双保险） */
.sel-item { margin-top: 10rpx; } /* 2026-11-25 滚动内容内部下移，红叉不被裁 */
.sel-bar { white-space: nowrap; width: 100%; padding: 12rpx 4rpx 2rpx; box-sizing: border-box; } /* 顶垫高防红叉裁剪 */
.sel-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 26rpx;
  vertical-align: top;
}
.sel-av-wrap { position: relative; }
.sel-av {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--primary, #0d9488);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sel-av-img { width: 84rpx; height: 84rpx; border-radius: 50%; display: block; }
.sel-av-txt { line-height: 84rpx; }
.sel-x {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #fff;
  font-size: 26rpx;
  line-height: 30rpx;
  text-align: center;
  border: 2rpx solid #fff;
}
.sel-name {
  margin-top: 8rpx;
  max-width: 110rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: var(--ink-700);
  text-align: center;
}

.group-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--border);
}
.btn-disabled { opacity: 0.5; }

/* 头像图（2026-11-13）：花名册真实头像 / 默认头像回退，覆盖 .stu-av 底色 */
.stu-av-img {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: block;
}
