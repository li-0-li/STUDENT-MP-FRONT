/* 群成员列表：头像 + 姓名/学号 + 群主/我 标签 */
.mem-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--border);
  padding: 22rpx 32rpx;
}
.mem-av {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--primary, #0d9488);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.mem-mid { flex: 1; min-width: 0; }
.mem-name { font-size: 30rpx; color: var(--ink-700); }
.mem-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #fff;
  background: var(--primary, #0d9488);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}
.mem-tag-me { background: var(--ink-300, #94a3b8); }
.mem-end { padding: 32rpx 0; }

/* 成员真实头像 + 资料卡（2026-11-12） */
.mem-av-img { width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0; }
.mem-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 99;
  display: flex; align-items: center; justify-content: center; }
.mem-card { width: 560rpx; background: #fff; border-radius: 24rpx; padding: 40rpx 32rpx 32rpx;
  display: flex; flex-direction: column; align-items: center; }
.mem-card-av { width: 140rpx; height: 140rpx; border-radius: 50%; }
.mem-card-av-txt { background: #0d9488; color: #fff; font-size: 56rpx;
  display: flex; align-items: center; justify-content: center; }
.mem-card-name { font-size: 34rpx; font-weight: 600; margin-top: 16rpx; }

/* 群信息头（2026-11-16 群头像更换入口） */
.mem-group-head {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.mem-group-av-wrap { position: relative; }
.mem-group-av {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}
.mem-group-av-txt {
  background: #0d9488;
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mem-group-av-edit {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  background: #0d9488;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
}
.mem-group-mid { margin-left: 20rpx; }
.mem-group-name { font-size: 30rpx; font-weight: 600; }

/* 群主管理（2026-11-18 踢人/解散）：危险操作红色系 */
.mem-card-btn {
  margin-top: 32rpx;
  width: 100%;
  text-align: center;
  font-size: 30rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #f1f5f9;
  color: var(--ink-700, #334155);
}
.mem-card-btn-danger { background: #fef2f2; color: #dc2626; }
.mem-dissolve {
  margin: 40rpx 32rpx 60rpx;
  padding: 24rpx 0;
  text-align: center;
  background: #fff;
  color: #dc2626;
  font-size: 30rpx;
  border-radius: 16rpx;
}
