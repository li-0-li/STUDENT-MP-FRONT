<!-- 消息通知 —— 原型：ui-prototype/mp/app-messages.html（UI 设计文档 7.14） -->
<!-- 聚合系统通知 + 师生会话；数据：表 2-10/2-11/2-12 会话消息 + 表 2-13 通知 -->
<view class="page">
  <!-- 顶部切换：通知 / 会话 -->
  <view class="pilltabs top-tabs">
    <view class="pill {{tab === 'notice' ? 'active' : ''}}" bindtap="selectTab" data-key="notice">通知</view>
    <view class="pill {{tab === 'chat' ? 'active' : ''}}" bindtap="selectTab" data-key="chat">会话</view>
  </view>

  <!-- ① 通知：按课程分组的「文件夹」，点击进入该课程通告子页（course-notice） -->
  <block wx:if="{{tab === 'notice'}}">
    <view wx:for="{{notices}}" wx:key="id" class="notice-folder" bindtap="openFolder" data-idx="{{index}}">
      <text class="notice-folder-name">{{item.title}}</text>
      <view wx:if="{{item.unread}}" class="msg-dot notice-folder-dot"></view>
      <text class="notice-folder-arrow">›</text>
    </view>
    <view wx:if="{{loading}}" class="center muted small msg-end">加载中…</view>
    <view wx:if="{{!loading && notices.length === 0}}" class="empty">
      <view class="empty-icon">📭</view>
      <view class="small">暂无系统通知</view>
    </view>
  </block>

  <!-- ② 师生会话列表 -->
  <block wx:if="{{tab === 'chat'}}">
    <view wx:for="{{chats}}" wx:key="id" class="conv" bindtap="openChat" bindlongpress="deleteChat" data-id="{{item.id}}">
      <view class="msg-av" style="background:{{item.color}}">{{item.initial}}
        <view wx:if="{{item.unread}}" class="msg-dot msg-dot-num">{{item.unread > 9 ? '9+' : item.unread}}</view>
      </view>
      <view class="msg-mid">
        <view class="between">
          <view class="msg-name-row">
            <text wx:if="{{item.pinned}}" class="conv-flag">📌</text>
            <text wx:if="{{item.muted}}" class="conv-flag">🔇</text>
            <text class="msg-name msg-name-ellipsis">{{item.name}}</text>
          </view>
          <text class="small muted conv-time">{{item.time}}</text>
        </view>
        <view class="conv-last small">{{item.muted ? '［免打扰］' : ''}}{{item.last}}</view>
      </view>
    </view>
    <view wx:if="{{!loading && chats.length === 0}}" class="empty">
      <view class="empty-icon">💬</view>
      <view class="small">暂无会话，点右下角 + 发起对话</view>
    </view>
  </block>

  <view class="center muted small msg-end">— 长按会话可置顶 / 免打扰 / 删除 —</view>

  <!-- 发起新对话：群聊 / 私聊同学 / 联系任课教师 -->
  <view wx:if="{{tab === 'chat' && !chatOpen}}" class="fab" bindtap="fabTap">＋</view>

  <!-- 聊天详情浮层（表 2-11/2-12 会话消息；期3：图片/文件/撤回/转发/历史/搜索） -->
  <view wx:if="{{chatOpen}}" class="chat-page">
    <view class="chat-head">
      <view class="chat-back" bindtap="closeChat">‹</view>
      <view class="chat-head-mid" bindtap="openMembers">
        <view class="chat-head-name">{{chat.name}}</view>
        <view class="small muted">{{chat.sub}}</view>
      </view>
      <view class="chat-head-act" bindtap="openRecords">🔍</view>
      <view wx:if="{{chat.type === 'group'}}" class="chat-head-act" bindtap="groupMenu">···</view>
    </view>

    <!-- 消息区：上拉到顶加载更早历史（beforeId 翻页） -->
    <scroll-view class="chat-body" scroll-y scroll-into-view="{{chatScrollInto}}"
      bindscrolltoupper="loadHistory" scroll-upper-threshold="30">
      <view class="chat-bub-sys" wx:if="{{chat.msgs.length === 0}}">会话已建立，发送第一条消息吧</view>
      <view wx:for="{{chat.msgs}}" wx:key="index" id="m-{{item.id}}"
        class="{{item.recalled ? 'chat-msg-sys-row' : 'chat-msg ' + (item.from === 'me' ? 'u' : 'a')}}"
        bindlongpress="longPressMsg" data-idx="{{index}}">
        <!-- 已撤回：居中灰色小字系统提示，无气泡框，群聊/私聊同款（期3修订） -->
        <view wx:if="{{item.recalled}}" class="chat-recalled-sys">该消息已被撤回</view>
        <!-- 图片消息：气泡内缩略图，点按全屏预览 -->
        <view wx:elif="{{item.type === 'image'}}" class="chat-bub chat-bub-media">
          <image class="chat-img" src="{{item.url}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.url}}" />
          <view class="chat-tm">{{item.time}}</view>
        </view>
        <!-- 视频消息：内联播放（期3修订） -->
        <view wx:elif="{{item.type === 'video'}}" class="chat-bub chat-bub-media">
          <video class="chat-video" src="{{item.url}}" object-fit="contain" />
          <view class="chat-tm">{{item.time}}</view>
        </view>
        <!-- 文件消息：文件卡片（文件名 + 大小），点按下载后打开 -->
        <view wx:elif="{{item.type === 'file'}}" class="chat-bub chat-bub-file" bindtap="openFile" data-url="{{item.url}}" data-name="{{item.name}}">
          <view class="chat-file-icon">📄</view>
          <view class="chat-file-info">
            <view class="chat-file-name">{{item.name}}</view>
            <view class="small muted">{{item.size}}</view>
          </view>
          <view class="chat-tm">{{item.time}}</view>
        </view>
        <!-- 文本消息 -->
        <view wx:else class="chat-bub">{{item.text}}<view class="chat-tm">{{item.time}}</view></view>
      </view>
      <view id="m-bottom"></view>
    </scroll-view>

    <!-- 输入栏：+ 号（发图片/文件）+ 文本输入 + 发送 -->
    <view class="chat-foot">
      <view class="chat-plus" bindtap="chatPlus">＋</view>
      <input class="input" value="{{chatInput}}" bindinput="onChatInput" placeholder="输入消息…" confirm-type="send" bindconfirm="sendChat" />
      <view class="btn btn-primary btn-sm" bindtap="sendChat">发送</view>
    </view>
  </view>
</view>
