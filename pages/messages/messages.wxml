<!-- 消息通知 —— 原型：ui-prototype/mp/app-messages.html（UI 设计文档 7.14） -->
<!-- 聚合系统通知 + 师生会话；数据：表 2-10/2-11/2-12 会话消息 + 表 2-13 通知 -->
<view class="page">
  <!-- 顶部切换：通知 / 会话（2026-11-24：右侧加号=新建会话入口，与两 pill 同一水平线） -->
  <view class="tabs-row">
    <view class="pilltabs top-tabs">
      <!-- pill 未读红点（2026-11-24）：通知=通知列表未读总和；会话=会话未读总和；tabbar=两者合计 -->
      <view class="pill {{tab === 'notice' ? 'active' : ''}}" bindtap="selectTab" data-key="notice">
        通知
        <view wx:if="{{noticeUnread}}" class="pill-dot">{{noticeUnread > 99 ? '99+' : noticeUnread}}</view>
      </view>
      <view class="pill {{tab === 'chat' ? 'active' : ''}}" bindtap="selectTab" data-key="chat">
        会话
        <view wx:if="{{chatUnread}}" class="pill-dot">{{chatUnread > 99 ? '99+' : chatUnread}}</view>
      </view>
    </view>
    <view wx:if="{{tab === 'chat' && !chatOpen}}" class="fab-top" bindtap="fabTap">＋</view>
  </view>

  <!-- ① 通知：按课程分组的「文件夹」，点击进入该课程通告子页（course-notice） -->
  <block wx:if="{{tab === 'notice'}}">
    <view wx:for="{{notices}}" wx:key="id" class="notice-folder" bindtap="openFolder" data-idx="{{index}}">
      <text class="notice-folder-name">{{item.title}}</text>
      <!-- 未读红点角标：红点内显示未读消息数量（0 不显示，与会话列表未读数同款样式） -->
      <view wx:if="{{item.unread}}" class="msg-dot notice-folder-dot msg-dot-num">{{item.unread}}</view>
      <text class="notice-folder-arrow">›</text>
    </view>
    <view wx:if="{{loading}}" class="center muted small msg-end">加载中…</view>
    <view wx:if="{{!loading && notices.length === 0}}" class="empty">
      <view class="empty-icon">📭</view>
      <view class="small">暂无系统通知</view>
    </view>
  </block>

  <!-- ② 师生会话列表 -->
  <block wx:if="{{tab === 'chat'}}">
    <view wx:for="{{chats}}" wx:key="id" class="conv" bindtap="openChat" bindlongpress="deleteChat" data-id="{{item.id}}">
      <view class="msg-av msg-av-rel" style="{{item.avatarUrl && !item.avFail ? '' : 'background:' + item.color}}">
        <image wx:if="{{item.avatarUrl && !item.avFail}}" class="msg-av-img" src="{{item.avatarUrl}}" mode="aspectFill"
               data-idx="{{index}}" binderror="onConvAvError" />
        <block wx:else>{{item.initial}}</block>
        <view wx:if="{{item.unread}}" class="msg-dot msg-dot-num">{{item.unread > 9 ? '9+' : item.unread}}</view>
      </view>
      <view class="msg-mid">
        <view class="between">
          <view class="msg-name-row">
            <text wx:if="{{item.pinned}}" class="conv-flag">📌</text>
            <text wx:if="{{item.muted}}" class="conv-flag">🔇</text>
            <text class="msg-name msg-name-ellipsis">{{item.name}}</text>
          </view>
          <text class="small muted conv-time">{{item.time}}</text>
        </view>
        <view class="conv-last small">{{item.muted ? '［免打扰］' : ''}}{{item.last}}</view>
      </view>
    </view>
    <view wx:if="{{!loading && chats.length === 0}}" class="empty">
      <view class="empty-icon">💬</view>
      <view class="small">暂无会话，点右下角 + 发起对话</view>
    </view>
  </block>

  <view class="center muted small msg-end">— 长按会话可置顶 / 免打扰 / 删除 —</view>

  <!-- 发起新对话：群聊 / 私聊同学 / 联系任课教师 -->
  <!-- 聊天详情浮层（表 2-11/2-12 会话消息；期3：图片/文件/撤回/转发/历史/搜索） -->
  <view wx:if="{{chatOpen}}" class="chat-page">
    <view class="chat-head">
      <view class="chat-back" bindtap="closeChat">‹</view>
      <view class="chat-head-mid" bindtap="openMembers">
        <view class="chat-head-name">{{chat.name}}</view>
        <view class="small muted">{{chat.sub}}</view>
      </view>
      <view class="chat-head-act" bindtap="openRecords">🔍</view>
      <view wx:if="{{chat.type !== 'direct'}}" class="chat-head-act" bindtap="groupMenu">···</view>
    </view>

    <!-- 消息区：上拉到顶加载更早历史（beforeId 翻页） -->
    <scroll-view class="chat-body" scroll-y scroll-into-view="{{chatScrollInto}}"
      bindscrolltoupper="loadHistory" scroll-upper-threshold="30">
      <view class="chat-bub-sys" wx:if="{{chat.msgs.length === 0}}">会话已建立，发送第一条消息吧</view>
      <view wx:for="{{chat.msgs}}" wx:key="index" id="m-{{item.id}}"
        class="{{item.recalled || item.type === 'system' ? 'chat-msg-sys-row' : 'chat-msg ' + (item.from === 'me' ? 'u' : 'a')}}"
        bindlongpress="longPressMsg" data-idx="{{index}}">
        <!-- 入群系统气泡（2026-11-24）：居中灰色小字「'某某'加入了群聊」，无头像无气泡框 -->
        <view wx:if="{{item.type === 'system'}}" class="chat-recalled-sys">{{item.text}}</view>
        <!-- 头像列（2026-11-12）：QQ 式，自己靠右（.u 行 row-reverse 自动置右）；点按看资料卡 -->
        <view wx:elif="{{!item.recalled}}" class="chat-av-wrap" bindtap="showSenderProfile" data-id="{{item.senderId}}">
          <image wx:if="{{item.avatarUrl && !item.avFail}}" class="chat-av" src="{{item.avatarUrl}}" mode="aspectFill"
                 data-idx="{{index}}" binderror="onMsgAvError" />
          <view wx:else class="chat-av chat-av-txt">{{item.senderInitial}}</view>
        </view>
        <!-- 已撤回：居中灰色小字系统提示，无气泡框，群聊/私聊同款（期3修订） -->
        <view wx:if="{{item.recalled}}" class="chat-recalled-sys">该消息已被撤回</view>
        <!-- 气泡容器（2026-11-13）：群聊时发送者名在气泡上方；system 入群气泡不走气泡框 -->
        <view wx:if="{{!item.recalled && item.type !== 'system'}}" class="chat-main">
          <view wx:if="{{chat.type !== 'direct' && item.senderName}}" class="chat-sender">{{item.senderName}}</view>
        <!-- 图片消息：气泡内缩略图，点按全屏预览。
             ★ 2026-11-16 此前写成 wx:elif，与上行 chat-sender 的 wx:if 构成同一条条件链——
             群聊里带发送者名的消息只渲染名字行，气泡全部被跳过（9027 观感=头像/气泡全丢）。
             改为 wx:if 独立成链 -->
        <view wx:if="{{item.type === 'image'}}" class="chat-bub chat-bub-media">
          <image class="chat-img" src="{{item.url}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.url}}" />
          <view class="chat-tm">{{item.time}}</view>
        </view>
        <!-- 视频消息：内联播放器（2026-11-16 样式对齐课程导学说课视频：原生 video + 圆角 + controls） -->
        <view wx:elif="{{item.type === 'video'}}" class="chat-bub chat-bub-video">
          <video class="chat-video" src="{{item.url}}" controls show-center-play-btn object-fit="contain"
                 data-idx="{{index}}" binderror="onVideoError"></video>
          <view class="small muted chat-video-cap">🎬 视频消息<text wx:if="{{item.size}}"> · {{item.size}}</text><text> · {{item.time}}</text></view>
        </view>
        <!-- 文件消息：文件卡片（文件名 + 大小），点按下载后打开 -->
        <view wx:elif="{{item.type === 'file'}}" class="chat-bub chat-bub-file" bindtap="openFile" data-url="{{item.url}}" data-name="{{item.name}}">
          <view class="chat-file-icon">📄</view>
          <view class="chat-file-info">
            <view class="chat-file-name">{{item.name}}</view>
            <view class="small muted">{{item.size}}</view>
          </view>
          <view class="chat-tm">{{item.time}}</view>
          <!-- 下载小标（2026-11-12）：仅下载保存，不触发预览 -->
          <view class="chat-dl" catchtap="downloadAttachment" data-url="{{item.url}}" data-name="{{item.name}}">⬇</view>
        </view>
        <!-- 文本消息 -->
        <view wx:else class="chat-bub">{{item.text}}<view class="chat-tm">{{item.time}}</view></view>
        </view>
      </view>
      <view id="m-bottom"></view>
    </scroll-view>

    <!-- 输入栏：+ 号（发图片/文件）+ 文本输入 + 发送 -->
    <!-- 发送者资料卡（2026-11-12）：点头像弹出，点遮罩关闭 -->
    <view wx:if="{{senderProfile}}" class="mem-mask" bindtap="hideSenderProfile">
      <view class="mem-card" catchtap="">
        <image wx:if="{{senderProfile.avatarShow && !senderProfile.avFail}}" class="mem-card-av" src="{{senderProfile.avatarUrl}}" mode="aspectFill"
               binderror="onSpAvError" />
        <view wx:else class="mem-card-av mem-card-av-txt">{{senderProfile.initial}}</view>
        <view class="mem-card-name">{{senderProfile.name}}</view>
        <view class="small muted mt4" wx:if="{{senderProfile.studentNo}}">学号 {{senderProfile.studentNo}}</view>
        <view class="small muted mt4" wx:if="{{senderProfile.className}}">班级 {{senderProfile.className}}</view>
        <view class="small muted mt4" wx:if="{{chat.type !== 'direct'}}">角色：{{senderProfile.isOwner ? '群主' : '成员'}}</view>
      </view>
    </view>

    <view class="chat-foot">
      <view class="chat-plus" bindtap="chatPlus">＋</view>
      <input class="input" value="{{chatInput}}" bindinput="onChatInput" placeholder="输入消息…" confirm-type="send" bindconfirm="sendChat" />
      <view class="btn btn-primary btn-sm" bindtap="sendChat">发送</view>
    </view>
  </view>
</view>
