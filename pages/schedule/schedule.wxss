/* 我的课表 —— 周切换 / 课程时间块；.card/.badge/.btn 等见 app.wxss */

/* 周次切换条（上一周 / 周次徽标 / 下一周） */
.week-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 24rpx 24rpx 8rpx;
}
.week-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-soft);
  color: var(--ink-600);
  font-size: 34rpx;
  line-height: 52rpx;
  text-align: center;
}
.week-badge {
  min-width: 140rpx;
  padding: 4rpx 12rpx;
  background: transparent;
  color: var(--ink-700);
  font-size: 26rpx;
  justify-content: center;
  text-align: center;
}
.back-today { padding-bottom: 8rpx; color: var(--brand-600); }
.link { color: var(--brand-600); font-weight: 600; }

/* 周一~周日：7 个等宽，平均占满整行 */
.dayrow {
  display: flex;
  align-items: stretch;
  padding: 24rpx 16rpx 8rpx;
}
.daypill {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  margin: 0 4rpx;
  border-radius: 12rpx;
  background: var(--bg-soft);
  border: 3rpx solid transparent;
  color: var(--ink-600);
  box-sizing: border-box;
  overflow: hidden;
}
.daypill .dn {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}
.daypill .td {
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1.3;
  color: var(--brand-600);
}
.daypill .today-mark { color: #e11d48; }
.daypill.active {
  background: var(--brand-600);
  color: #fff;
}
.daypill.active .td { color: rgba(255, 255, 255, 0.9); }
.daypill.active .today-mark { color: #fff; }

/* 日期标题行 */
.day-head { margin: 16rpx 24rpx 12rpx; }
.day-title { font-size: 30rpx; font-weight: 700; }

/* 课程时间块卡片 */
.cls-card { display: flex; gap: 24rpx; }
.cls-time { flex: none; min-width: 128rpx; text-align: left; }
.strong { font-weight: 600; }
.cls-time-t { font-size: 20rpx; }
.cls-body { flex: 1; min-width: 0; }
.cls-name { font-size: 30rpx; font-weight: 700; }
