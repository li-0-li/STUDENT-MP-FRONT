/* 全部排课页局部样式（2026-11-10 改版）：复用全局 card/badge/small/mt4/mt8 */
.cs-term { padding: 8rpx 8rpx 0; }

.cs-week { margin-bottom: 8rpx; }
.cs-week-cur { border: 2rpx solid rgba(13, 148, 136, 0.45); }
.cs-week-title { font-size: 30rpx; font-weight: 600; color: var(--ink-900, #1c2b3a); }

/* 周级共用分组 */
.cs-common { margin-top: 12rpx; padding: 12rpx; background: rgba(13, 148, 136, 0.06); border-radius: 12rpx; }
.cs-group-title { margin-bottom: 8rpx; }

/* 课次小卡片 */
.cs-lesson { margin-top: 12rpx; padding: 12rpx; border: 1rpx solid rgba(12, 74, 110, 0.12); border-radius: 12rpx; }
.cs-lesson-head { font-size: 28rpx; font-weight: 500; }
.cs-lesson-time { color: var(--ink-400, #94a3b8); font-weight: 400; }
.cs-lesson-body { margin-top: 8rpx; }

/* 资源挂载条目（作业/实验/文件共用） */
.cs-item { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 8rpx; border-radius: 8rpx; background: rgba(12, 74, 110, 0.04); margin-top: 8rpx; }
.cs-item:active { background: rgba(12, 74, 110, 0.1); }
.cs-ico { font-size: 28rpx; }
.cs-item-name { flex: 1; font-size: 26rpx; color: var(--ink-700, #334155); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cs-item-meta { font-size: 22rpx; color: var(--ink-400, #94a3b8); }

.cs-empty { padding: 8rpx 0; }
