/* ===== 通用图标挂载 ===== */
.ic { background-repeat: no-repeat; background-position: center; background-size: 100% 100%; flex: none; }
.ic-role { width: 36rpx; height: 36rpx; }        /* 角色卡图标 18px */
.ic-logo { width: 68rpx; height: 68rpx; }         /* logo 学士帽 34px */
.ic-tip { width: 28rpx; height: 28rpx; }          /* 提示条 monitor 14px */
.ic-note { width: 28rpx; height: 28rpx; margin-top: 4rpx; } /* bind-note 图标 14px */
.ic-svc { width: 32rpx; height: 32rpx; }          /* 联系客服 headphones 16px */

.auth-form { margin-top: 32rpx; }

/* ===== logo（原型 .m-auth .logo：64px 盒/圆角16/品牌绿底/白图标；带 .auth-box 前缀压过 app.wxss 同名规则） ===== */
.auth-box .logo {
  width: 128rpx; height: 128rpx; border-radius: 32rpx;
  background: var(--brand-600);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 36rpx;
  font-size: 0;
}
.logo-ic { width: 68rpx; height: 68rpx; }
.auth-box .h2 { display: block; text-align: center; font-size: 36rpx; font-weight: 700; color: var(--ink-900); }
.auth-box .sub { text-align: center; color: var(--ink-500); font-size: 26rpx; margin: 12rpx 0 44rpx; }

/* ===== 身份选择（老师 / 学生；管理员仅电脑端，不展示） ===== */
.m-roles { display: flex; gap: 16rpx; margin: 28rpx 0 24rpx; }
.m-role {
  flex: 1;
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  padding: 20rpx 8rpx;
  border: 3rpx solid var(--border); border-radius: 28rpx;
  background: #fff;
  color: var(--ink-600); font-size: 25rpx; font-weight: 600;
  transition: all .15s ease;
  user-select: none;
}
.m-role .mr-ic {
  width: 64rpx; height: 64rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg-soft); color: var(--ink-500);
}
.m-role.active { border-color: var(--brand-600); background: #effefb; color: var(--brand-700); }
.m-role.active .mr-ic { background: var(--brand-600); color: #fff; }

/* ===== 身份提示条（选中老师时显示；原型 showTip 非警告态：brand-700/brand-50） ===== */
.m-tip {
  display: none;
  align-items: center; gap: 12rpx;
  font-size: 24rpx; color: var(--brand-700);
  background: #effefb;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}
.m-tip.show { display: flex; }

/* ===== 登录方式切换 ===== */
.mtab { display: flex; justify-content: center; margin-bottom: 24rpx; }

/* ===== 验证码方式提示（bind-note） ===== */
.bind-note {
  display: flex; gap: 14rpx; align-items: flex-start;
  font-size: 24rpx; color: var(--ink-500);
  background: var(--bg-subtle);
  border: 1rpx dashed var(--border);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 24rpx;
  line-height: 1.6;
}
.bind-note .ic-note { color: var(--brand-600); }

/* ===== 输入框（原型内联样式：圆角 12px、内边距 12px 14px） ===== */
.auth-input { height: 88rpx; padding: 0 28rpx; border-radius: 24rpx; }
.code-row { gap: 12rpx; }
.code-input { flex: 1; letter-spacing: 6rpx; }
.code-btn { flex: none; white-space: nowrap; }
.links { font-size: 26rpx; margin: -12rpx 0 36rpx; }
.link { color: var(--brand-600); font-weight: 600; }
/* 登录按钮：外层 flex 容器强制整行居中；重置原生 button 默认内边距 / ::after 边框 */
.btn-row { display: flex; justify-content: center; }
.auth-btn {
  flex: 1; height: 88rpx; line-height: 88rpx;
  border-radius: 24rpx; font-size: 28rpx;
  padding: 0; margin: 0;
}
.auth-btn::after { border: none; }
.svc-link {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  color: var(--brand-600); margin-top: 32rpx; font-size: 24rpx;
}
