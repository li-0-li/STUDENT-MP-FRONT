<!-- 章节作业 —— 原型：ui-prototype/mp/app-course-detail.html -->
<!-- 数据：表 3-2 课程详情 + 表 3-5 本课程作业列表 + 表 3-17 实验任务列表（均真实接口，按周挂载，实验与作业并排） -->
<view class="page">

  <!-- 课程头部信息（表 3-2） -->
  <view wx:if="{{course}}" class="card">
    <view class="between">
      <view class="row">
        <view class="icon-box">∑</view>
        <view>
          <view class="cd-title">{{course.courseName}}</view>
          <view class="small muted mt4">{{course.teacherName}} · {{course.statusText}}</view>
        </view>
      </view>
      <view class="badge {{course.badge}}">{{course.statusText}}</view>
    </view>
    <view class="small muted mt8">课程码 <text class="cd-code">{{course.courseCode}}</text></view>
  </view>
  <view wx:elif="{{loading}}" class="empty">
    <view class="small">加载中…</view>
  </view>

  <!-- 章节入口卡（2026-11-10：章节内容移入「章节目录」子页，此处仅留入口） -->
  <view wx:if="{{course && !loading}}" class="card cd-chapter" bindtap="goWeeks">
    <view class="between">
      <view class="cd-chapter-title">章节目录</view>
      <view class="badge badge-info">共 {{chapterCount}} 章</view>
    </view>
    <view class="small muted mt8">点击查看全部章节目录 ›</view>
  </view>

  <!-- 课程导学：说课视频（三重认证 approved 才展示，原型 pc/student-course-detail.html） -->
  <view wx:if="{{intro}}" class="card">
    <view class="cd-title" style="font-size:30rpx;">课程导学</view>
    <video class="mt8" src="{{intro.src}}" style="width:100%;border-radius:12rpx;"
           controls show-center-play-btn object-fit="contain"></video>
    <view class="small muted mt8">🎬 说课视频{{intro.durationText ? ' · ' + intro.durationText : ''}}</view>
  </view>

  <!-- 上课安排（2026-11-10 改版：只展示当前教学周 —— 第 N 周 大卡片 → 课次 → 资源挂载；
       每周一零点随 currentWeek 自然翻周，无需定时任务。全部周次进「全部排课」页） -->
  <view wx:if="{{course && !loading}}" class="card">
    <view class="between">
      <view class="cd-title" style="font-size:28rpx;">上课安排</view>
      <view wx:if="{{weekCount}}" class="view-all" style="margin-top:0;" bindtap="goAllSchedules">查看全部 ›</view>
    </view>

    <view wx:if="{{weekLabel}}" class="cd-week">
      <!-- 第 N 周 大卡片标题 -->
      <view class="between">
        <view class="cd-week-title">{{weekLabel}}</view>
        <view class="badge badge-info">{{weekLessons.length}} 课次</view>
      </view>

      <!-- 周级共用资源（未绑定课次的历史数据） -->
      <view wx:if="{{weekCommon.length}}" class="cd-week-common">
        <view class="small muted" style="margin-bottom:8rpx;">本周共用（未绑定课次）</view>
        <view wx:for="{{weekCommon}}" wx:key="id" wx:for-item="it" class="cd-item"
              bindtap="openItem" data-kind="{{it.kind}}" data-id="{{it.id}}"
              data-url="{{it.url}}" data-type="{{it.fileType}}">
          <text class="cd-item-ico">{{it.icon}}</text>
          <text class="cd-item-name">{{it.name}}</text>
          <view class="badge {{it.badge}}">{{it.statusText}}</view>
        </view>
      </view>

      <!-- 课次小卡片 + 资源小卡片 -->
      <view wx:for="{{weekLessons}}" wx:key="scheduleId" wx:for-item="l" class="cd-lesson">
        <view class="between">
          <view class="cd-lesson-head">{{l.weekdayText}} {{l.periodNo}}节 <text class="cd-lesson-time">{{l.timeText}}</text></view>
          <view wx:if="{{l.badge}}" class="badge {{l.badge}}">{{l.statusText}}</view>
        </view>
        <view wx:if="{{l.classroomName}}" class="small muted mt4">
          📍 {{l.classroomName}}<text wx:if="{{l.classroomLocation}}"> · {{l.classroomLocation}}</text>
        </view>

        <view wx:if="{{l.items.length}}" class="cd-lesson-body">
          <view wx:for="{{l.items}}" wx:key="id" wx:for-item="it" class="cd-item"
                bindtap="openItem" data-kind="{{it.kind}}" data-id="{{it.id}}"
                data-url="{{it.url}}" data-type="{{it.fileType}}">
            <text class="cd-item-ico">{{it.icon}}</text>
            <text class="cd-item-name">{{it.name}}</text>
            <text class="cd-item-meta">{{it.meta}}</text>
            <view class="badge {{it.badge}}">{{it.statusText}}</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="small muted mt8" style="padding:8rpx 0;">
      {{weekCount ? '本周暂无课次安排' : '教师暂未安排上课时间'}}
    </view>
  </view>

  <!-- 退出课程按钮 -->
  <view wx:if="{{course && !loading}}" class="withdraw-section">
    <button class="btn btn-outline btn-danger withdraw-btn" bindtap="confirmWithdraw">
      退出课程
    </button>
    <view class="small muted mt8" style="text-align:center;">退出后将无法查看本课程内容，且需重新加课才能恢复</view>
  </view>

</view>
