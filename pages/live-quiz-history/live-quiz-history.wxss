/* 随堂测试 · 历史测试 —— 通用样式见 app.wxss */
.center { text-align: center; }
.small { font-size: 24rpx; }
.muted { color: #64748b; }

.his-card { margin-bottom: 20rpx; }
.his-top { display: flex; align-items: center; justify-content: space-between; }
.his-title { font-weight: 700; font-size: 30rpx; }
.his-tag {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx;
  color: #16a34a; background: rgba(22, 163, 74, 0.1);
}

.his-meta {
  display: flex; flex-wrap: wrap; gap: 8rpx 24rpx;
  margin-top: 10rpx;
}

.his-score {
  display: flex; align-items: baseline; gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
}
.his-accuracy { font-size: 44rpx; font-weight: 700; color: #0d9488; }

.his-foot { display: flex; justify-content: flex-end; margin-top: 20rpx; }
.btn-sm { padding: 10rpx 32rpx; font-size: 26rpx; }
.btn-ghost {
  border: 2rpx solid #0d9488;
  color: #0d9488;
  border-radius: 12rpx;
  font-weight: 600;
}
