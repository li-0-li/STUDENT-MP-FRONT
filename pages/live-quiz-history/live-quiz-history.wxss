/* 随堂测试 · 历史测试 —— 全局 token 与 .card/.btn/.badge/.between/.small/.muted/.empty 见 app.wxss */

.his-card { margin-bottom: 20rpx; }

/* 进行中卡片：brand 浅底突出 */
.his-card.is-doing {
  background: linear-gradient(135deg, var(--brand-50) 0%, #fff 70%);
  border-color: var(--brand-100);
}

.his-top { display: flex; align-items: center; justify-content: space-between; }
.his-title { font-weight: 700; font-size: 30rpx; line-height: 1.4; }

.his-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  margin-top: 12rpx;
}

/* 成绩行：左成绩右操作 */
.his-score {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}
.his-score-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  min-width: 0;
}
.his-accuracy { font-size: 44rpx; font-weight: 700; color: var(--brand-600); }
