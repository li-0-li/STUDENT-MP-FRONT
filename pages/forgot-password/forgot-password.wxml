<!-- 找回密码 —— 原型：ui-prototype/mp/forgot-password.html（验证 → 重置 → 完成） -->
<view class="page">
  <!-- 步骤条 -->
  <view class="row step-bar">
    <view class="badge {{step >= 1 ? 'badge-info' : 'badge-neutral'}}">1 验证</view>
    <view class="badge {{step >= 2 ? 'badge-info' : 'badge-neutral'}}">2 重置</view>
    <view class="badge {{step >= 3 ? 'badge-info' : 'badge-neutral'}}">3 完成</view>
  </view>

  <!-- 第 1 步：验证身份 -->
  <view class="card" wx:if="{{step === 1}}">
    <view class="field">
      <text class="label">账号（学号 / 工号）</text>
      <input class="input" placeholder="请输入账号" value="{{account}}" bindinput="onAccount" />
    </view>
    <view class="field">
      <text class="label">绑定手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入绑定手机号" value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="field">
      <text class="label">短信验证码</text>
      <view class="row">
        <input class="input code-input" type="number" maxlength="6" placeholder="6 位验证码" value="{{code}}" bindinput="onCode" />
        <button class="btn btn-outline code-btn" size="mini" bindtap="sendCode" disabled="{{counting}}">
          {{counting ? countdown + 's' : '获取验证码'}}
        </button>
      </view>
    </view>
    <button class="btn btn-primary btn-block mt8" bindtap="toStep2">下一步</button>
  </view>

  <!-- 第 2 步：重置密码 -->
  <view class="card" wx:if="{{step === 2}}">
    <view class="field">
      <text class="label">新密码</text>
      <input class="input" password placeholder="8 位以上，含字母与数字" value="{{password}}" bindinput="onPwd" />
    </view>
    <view class="field">
      <text class="label">确认新密码</text>
      <input class="input" password placeholder="再次输入新密码" value="{{password2}}" bindinput="onPwd2" />
    </view>
    <button class="btn btn-primary btn-block mt8" bindtap="toStep3">确认重置</button>
  </view>

  <!-- 第 3 步：完成 -->
  <view class="card center done-box" wx:if="{{step === 3}}">
    <view class="done-icon">✓</view>
    <text class="done-title">密码重置成功</text>
    <view class="small muted mt8">请使用新密码登录</view>
    <button class="btn btn-primary btn-block mt16" bindtap="backLogin">返回登录</button>
  </view>

  <view class="center mt16">
    <text class="small link" bindtap="backLogin">← 返回登录</text>
  </view>
</view>
