/* 找回密码页 —— 复用 app.wxss 的 .card/.field/.btn/.badge，仅写本页私有样式 */
.step-bar { justify-content: center; gap: 16rpx; margin: 16rpx 24rpx 8rpx; }
.code-input { flex: 1; }
.code-btn { flex: none; white-space: nowrap; }
.link { color: var(--brand-600); font-weight: 600; }
.done-box { flex-direction: column; padding: 48rpx 32rpx; }
.done-icon {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: var(--brand-100); color: var(--success);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; margin-bottom: 16rpx;
}
.done-title { font-size: 32rpx; font-weight: 700; }
