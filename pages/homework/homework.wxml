<!-- 我的作业 —— 原型：ui-prototype/mp/app-homework.html -->
<!-- UI 设计 7.8（2026-10-28 改版）：页签「待提交 / 未批改 / 已批改 / 申诉」；作业+实验统一展示 -->
<view class="page">

  <!-- 状态页签（待提交 / 未批改 / 已批改 / 申诉） -->
  <!-- 课程筛选下拉（2026-11-11）：选课后四个页签只显示该课程的作业/实验 -->
  <view class="hw-course-filter">
    <picker mode="selector" range="{{courseOptions}}" range-key="name" value="{{courseIndex}}"
            bindchange="onCourseChange">
      <view class="hw-course-picker">
        <text>{{courseOptions[courseIndex].name}}</text>
        <text class="hw-picker-arrow">▾</text>
      </view>
    </picker>
  </view>

  <view class="hw-tabs-wrap">
    <view class="pilltabs hw-tabs">
      <view wx:for="{{tabs}}" wx:key="key"
            class="pill {{item.active ? 'active' : ''}} hw-tab"
            bindtap="switchTab" data-key="{{item.key}}">{{item.label}}</view>
    </view>
  </view>

  <!-- 作业 / 实验列表 -->
  <block wx:if="{{list.length}}">
    <view wx:for="{{list}}" wx:key="id" class="card"
          bindtap="goDetail" data-url="{{item.url}}">
      <view class="between">
        <view class="hw-title">{{item.kind === '实验' ? '🧪 ' : '📝 '}}{{item.title}}</view>
        <view class="badge {{item.badge}}">{{item.statusText}}</view>
      </view>
      <view class="small muted mt8">{{item.courseName}} · {{item.meta}}</view>
      <!-- 已批改：得分摘要（点击进详情查看完整评语） -->
      <view wx:if="{{item.status === 'graded' && item.score}}" class="small mt8 hw-score-line">得分：<text class="hw-score">{{item.score}}</text> 分</view>
      <view wx:if="{{item.extra}}" class="small mt8 {{item.extraWarn ? 'hw-extra-warn' : 'muted'}}">{{item.extra}}</view>
    </view>
  </block>

  <!-- 加载中 -->
  <view wx:elif="{{loading}}" class="card hw-empty">
    <view class="small muted mt8">加载中…</view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="card hw-empty">
    <view class="hw-empty-icon">📥</view>
    <view class="small muted mt8">{{emptyText}}</view>
  </view>

</view>
