<!-- 首页 —— 原型：ui-prototype/mp/app-home.html（UI 设计文档 7.3） -->
<!-- 数据：users/me + schedules + assignments + experiments + practice/recommend（真实接口） -->
<view class="page">
  <!-- ① 欢迎卡（2026-10-28 改版：删除学习指标与掌握度六维图，仅留问候） -->
  <view class="card hero">
    <view class="between">
      <text class="hero-title">{{greeting}}，{{name}} 👋</text>
      <view class="hero-pill">学情概览</view>
    </view>
  </view>

  <!-- ② 今日课程：当天课表（已开始的课剔除，进行中保留；按上课时间升序）。
       进行中的课：名称旁标「上课中」，右侧「进入课堂」直达实时课堂页（catchtap 防冒泡到整卡跳转） -->
  <view class="section-title">今日课程</view>
  <view
    wx:for="{{todayCourses}}" wx:key="id"
    class="card todo-item" bindtap="go" data-url="{{item.url}}">
    <view class="todo-icon">{{item.icon}}</view>
    <view class="todo-mid">
      <view class="between">
        <view class="row" style="gap:10rpx;align-items:center;min-width:0">
          <text class="small strong">{{item.name}}</text>
          <view wx:if="{{item.ongoing}}" class="badge badge-success live-tag">上课中</view>
        </view>
        <view wx:if="{{item.ongoing}}" class="btn-live" catchtap="go" data-url="/pages/live/live">进入课堂</view>
        <view wx:else class="badge {{item.badge}}">{{item.statusText}}</view>
      </view>
      <view class="small muted mt4">{{item.time}} · {{item.place}}</view>
    </view>
  </view>
  <view wx:if="{{todayCourses.length === 0}}" class="card center empty">
    <view class="empty-icon">🎉</view>
    <view class="small">今天没有课程，劳逸结合</view>
  </view>

  <!-- ③ 快捷功能宫格：AI 答疑 / 上课入口 / 添加课程 / 消息 -->
  <view class="section-title">快捷功能</view>
  <view class="card quick-grid">
    <view wx:for="{{quicks}}" wx:key="label" class="quick-item" bindtap="go" data-url="{{item.url}}">
      <view class="icon-box">{{item.icon}}</view>
      <view class="small mt4 quick-label">{{item.label}}</view>
    </view>
  </view>

  <!-- ④ 继续学习（最近学习资源；暂无接口，无数据时整块隐藏） -->
  <block wx:if="{{continueLearn}}">
    <view class="section-title">继续学习</view>
    <view class="card" bindtap="go" data-url="{{continueLearn.url}}">
    <view class="between">
      <text class="small strong">{{continueLearn.course}} · {{continueLearn.chapter}}</text>
      <view class="badge badge-info">{{continueLearn.status}}</view>
    </view>
    <view class="progress mt12">
      <view class="progress-fill" style="width:{{continueLearn.progress}}%"></view>
    </view>
    <view class="between mt8">
      <text class="small muted">进度 {{continueLearn.progress}}%</text>
      <text class="small link">继续 →</text>
    </view>
  </view>
  </block>

  <!-- ⑤ 我的作业：全部课程中未到截止时间的作业+实验（已提交未截止的也保留；
       已过截止但允许逾期提交的也保留；已批改且过截止的剔除）。
       四梯队排序：未提交（超期可补交最上、未到期截止近者靠上）→ 已提交未批改 → 申诉中 → 已提交已批改；
       可滚动，底部「查看全部」进作业页 -->
  <view class="section-title">我的作业</view>
  <view class="card hw-todo-card">
    <scroll-view wx:if="{{todoTasks.length}}" scroll-y class="hw-todo-scroll">
      <view
        wx:for="{{todoTasks}}" wx:key="id"
        class="hw-todo-item" bindtap="go" data-url="{{item.url}}">
        <view>
          <view class="small strong">{{item.type === '实验' ? '🧪 ' : '📝 '}}{{item.title}}</view>
          <view class="small muted mt8">{{item.courseName}} · {{item.deadline}}</view>
        </view>
        <view class="badge {{item.badge}}">{{item.status}}</view>
      </view>
    </scroll-view>
    <view wx:else class="hw-todo-empty small muted">暂未截止的作业和实验</view>
    <view class="hw-todo-footer" bindtap="go" data-url="/pages/homework/homework">
      <text class="small link">查看全部 →</text>
    </view>
  </view>

  <!-- ⑥ 为你推荐（AI 学习建议）—— 点击进学情分析看完整建议 -->
  <view class="section-title">为你推荐</view>
  <view class="card row" bindtap="go" data-url="/pages/analytics/analytics">
    <view class="icon-box">🎯</view>
    <view>
      <view class="small strong">{{recommend.title}}</view>
      <view class="small muted mt8">{{recommend.desc}}</view>
    </view>
  </view>
</view>
