/* 首页 —— 学情概览 / 待办 / 宫格等私有样式；.card/.badge/.icon-box/.progress 等见 app.wxss */

/* ① 学情概览卡（原型：brand-600 → brand-700 渐变）。
   2026-10-28 改版：删除雷达小卡与学习指标样式，仅留问候行 */
.hero {
  background: linear-gradient(135deg, var(--brand-600), var(--brand-700));
  border: none;
  color: #fff;
}
.hero-title { font-size: 32rpx; font-weight: 700; color: #fff; }

/* ② 今日课程条目 */
.todo-item { display: flex; gap: 20rpx; align-items: center; }
.todo-icon {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 18rpx;
  background: #effefb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}
.todo-icon.todo-lab { background: #fef3c7; }
.todo-mid { flex: 1; min-width: 0; }
.strong { font-weight: 600; }


/* 今日课程 · 上课中课程：名称旁小标签 + 右侧进入课堂按钮（2026-10-29） */
.live-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 999rpx;
  animation: livePulse 1.6s ease-in-out infinite;
}
@keyframes livePulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
.btn-live {
  flex-shrink: 0;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #fff;
  background: var(--brand-600, #0d9488);
  border-radius: 999rpx;
}

/* 我的任务（2026-11-24 独立卡片形态，原型方案）：
   每条待办一张固定大小卡片，外层 scroll-view 可滚动 */
.task-scroll {
  max-height: 560rpx;
  margin: 0 0 8rpx;
}
.task-card {
  min-height: 132rpx;              /* 固定大小：两行内容统一高度 */
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.task-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.task-footer {
  padding: 16rpx 0 4rpx;
  text-align: center;
}
.hw-todo-empty { padding: 32rpx 0; }

/* 我的任务外层边框容器（2026-11-24）：简洁描边与 .card 同视觉语言，
   rpx + CSS 变量自适应各类屏幕，不改变内部布局与间距 */
.task-box {
  margin: 0 24rpx 20rpx;             /* 与 .card 左右对齐 */
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 16rpx;
}
.task-box .task-scroll { margin: 0; }
.task-box .card { margin: 0 0 12rpx; }  /* 嵌套后去掉 .card 自带的页面级左右边距 */
.task-box .task-card:last-child { margin-bottom: 8rpx; }
/* 查看全部入口：置于「我的任务」标题右侧（2026-11-24 移入标题行） */
.task-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-right: 24rpx;   /* 与 .task-box 左右对齐 */
}
.task-box .hw-todo-empty { margin: 0; }
