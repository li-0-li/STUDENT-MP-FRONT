/* 首页 —— 学情概览 / 待办 / 宫格等私有样式；.card/.badge/.icon-box/.progress 等见 app.wxss */

/* ① 学情概览卡（原型：brand-600 → brand-700 渐变） */
.hero {
  background: linear-gradient(135deg, var(--brand-600), var(--brand-700));
  border: none;
  color: #fff;
}
.hero-title { font-size: 32rpx; font-weight: 700; color: #fff; }
.hero-pill {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex: none;
}
.hero-sub { color: var(--brand-100); }
.hero-body { gap: 32rpx; margin-top: 24rpx; align-items: center; }
/* 雷达小卡：白色描摹适配深色卡底 */
.hero-radar {
  flex: none;
  width: 172rpx;
  text-align: center;
}
.radar-canvas { width: 172rpx; height: 172rpx; }
.radar-label { margin-top: 4rpx; }
/* 关键学习指标 */
.hero-stats {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 40rpx;
}
.hero-stat { min-width: 150rpx; }
.hero-num { font-size: 38rpx; font-weight: 800; color: #fff; }

/* ② 今日待办条目 */
.todo-item { display: flex; gap: 20rpx; align-items: center; }
.todo-icon {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 18rpx;
  background: #effefb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}
.todo-icon.todo-lab { background: #fef3c7; }
.todo-mid { flex: 1; min-width: 0; }
.strong { font-weight: 600; }

/* ③ 快捷功能宫格：4 列 */
.quick-grid { display: flex; flex-wrap: wrap; padding: 24rpx 12rpx; }
.quick-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  text-align: center;
}
.quick-label { color: var(--ink-600); }

/* ④ 继续学习「继续 →」链接色 */
.link { color: var(--brand-600); font-weight: 600; }
