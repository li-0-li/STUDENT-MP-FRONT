/* 首页 —— 学情概览 / 待办 / 宫格等私有样式；.card/.badge/.icon-box/.progress 等见 app.wxss */

/* ① 学情概览卡（原型：brand-600 → brand-700 渐变）。
   2026-10-28 改版：删除雷达小卡与学习指标样式，仅留问候行 */
.hero {
  background: linear-gradient(135deg, var(--brand-600), var(--brand-700));
  border: none;
  color: #fff;
}
.hero-title { font-size: 32rpx; font-weight: 700; color: #fff; }
.hero-pill {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex: none;
}

/* ② 今日课程条目 */
.todo-item { display: flex; gap: 20rpx; align-items: center; }
.todo-icon {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 18rpx;
  background: #effefb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}
.todo-icon.todo-lab { background: #fef3c7; }
.todo-mid { flex: 1; min-width: 0; }
.strong { font-weight: 600; }

/* ③ 快捷功能宫格：4 列 */
.quick-grid { display: flex; flex-wrap: wrap; padding: 24rpx 12rpx; }
.quick-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  text-align: center;
}
.quick-label { color: var(--ink-600); }

/* ④ 继续学习「继续 →」链接色 */
.link { color: var(--brand-600); font-weight: 600; }

/* ⑤ 我的作业卡：固定高度可滚动列表 + 底部「查看全部」入口 */
.hw-todo-card { padding-bottom: 0; }
.hw-todo-scroll { max-height: 480rpx; }
.hw-todo-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid var(--line, #f0f0f0);
}
.hw-todo-empty { padding: 40rpx 0; text-align: center; }
.hw-todo-footer {
  padding: 20rpx 0 24rpx;
  text-align: center;
  border-top: 1rpx solid var(--line, #f0f0f0);
}
