/* 我的学情 —— 原型：ui-prototype/mp/app-analytics.html */

/* 统计卡高亮数字（班级排名） */
.stat-num.hl { color: var(--brand-600); }

/* 课程进度 */
.course-name { font-size: 28rpx; font-weight: 600; }
.mb-bar { margin-bottom: 8rpx; }

/* 卡片内小标题（对应原型 <b class="small">） */
.card-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-900);
}

/* 掌握度雷达图（canvas 2d） */
.radar-wrap {
  display: flex;
  justify-content: center;
  margin: 16rpx 0 24rpx;
}
.radar-canvas { width: 460rpx; height: 420rpx; }

/* 作业成绩折线图（canvas 2d） */
.line-wrap { margin-top: 16rpx; }
.trend-canvas { width: 100%; height: 240rpx; }

/* 雷达图下方的维度标注列表 */
.mastery-item { margin-bottom: 24rpx; }
.mastery-item:last-child { margin-bottom: 0; }
.mastery-name { font-size: 26rpx; color: var(--ink-900); }
.mastery-name.weak { color: var(--warning); font-weight: 600; }

/* 掌握度偏低时进度条用警示色 */
.progress-fill.fill-warn { background: var(--warning); }

/* AI 学习建议卡（原型为品牌色底） */
.advice-card {
  background: var(--brand-50);
  border-color: var(--brand-100);
}
.advice-row { align-items: flex-start; }
.advice-text { color: var(--ink-600); line-height: 1.65; }
.advice-title { display: block; color: var(--ink-900); font-weight: 700; margin-bottom: 4rpx; }
.btn-slim { height: 80rpx; line-height: 80rpx; padding: 0 20rpx; }

/* 错题本入口 */
.wb-title { font-size: 28rpx; font-weight: 600; }
.list-link { font-size: 40rpx; }

/* 错题本弹层 */
.wb-mask { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5); z-index: 100; display: flex; align-items: flex-end; }
.wb-sheet { width: 100%; max-height: 75vh; background: #fff; border-radius: 24rpx 24rpx 0 0; display: flex; flex-direction: column; padding-bottom: env(safe-area-inset-bottom); }
.wb-sheet-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx 16rpx; }
.wb-sheet-title { font-size: 32rpx; font-weight: 600; }
.wb-sheet-close { font-size: 36rpx; color: #999; padding: 8rpx; }
.wb-sheet-loading { text-align: center; color: #999; font-size: 26rpx; padding: 80rpx 0; }
.wb-sheet-body { max-height: calc(75vh - 100rpx); padding: 0 32rpx 32rpx; box-sizing: border-box; }
.wb-group-title { font-size: 28rpx; font-weight: 600; margin: 24rpx 0 12rpx; }
.wb-q-item { background: #f7f8fa; border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; }
.wb-q-head { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.wb-q-type { font-size: 22rpx; color: #fff; background: #e6a23c; border-radius: 8rpx; padding: 2rpx 12rpx; }
.wb-q-count { font-size: 22rpx; color: #999; }
.wb-q-content { font-size: 28rpx; line-height: 1.5; }
.wb-q-analysis { font-size: 24rpx; color: #67c23a; margin-top: 10rpx; line-height: 1.5; }
.wb-q-type.ok { background: #67c23a; }

/* 推荐练习弹层 */
.pr-q-item { background: #f7f8fa; border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; }
.pr-opt { display: flex; align-items: center; background: #fff; border: 2rpx solid #e4e7ed; border-radius: 12rpx; padding: 16rpx 20rpx; margin-top: 12rpx; }
.pr-opt.on { border-color: #4080ff; background: #ecf3ff; }
.pr-opt-key { font-size: 26rpx; font-weight: 600; color: #4080ff; margin-right: 16rpx; }
.pr-opt.on .pr-opt-key { color: #4080ff; }
.pr-opt-text { font-size: 26rpx; flex: 1; }
.pr-blank { background: #fff; border: 2rpx solid #e4e7ed; border-radius: 12rpx; padding: 16rpx 20rpx; margin-top: 12rpx; font-size: 26rpx; }
.pr-submit { margin: 24rpx 0 8rpx; background: #4080ff; color: #fff; font-size: 28rpx; border-radius: 44rpx; }
.pr-result { background: #f0f9eb; color: #67c23a; border-radius: 12rpx; padding: 20rpx; font-size: 26rpx; margin-bottom: 16rpx; }
