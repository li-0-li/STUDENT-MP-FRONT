/* 实时课堂（2026-10-29 改版）—— 通用 .card/.between/.row/.small/.strong/.muted 见 app.wxss */
.online-box { text-align: center; }
.online-num { font-size: 34rpx; font-weight: 700; color: var(--brand-600, #0d9488); }

/* 导航 */
.live-nav { display: flex; padding: 8rpx; }
.live-nav-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-weight: 600;
  color: var(--muted, #64748b);
  position: relative;
}
.live-nav-item.on { background: var(--brand-600, #0d9488); color: #fff; }
.dot {
  position: absolute;
  top: 8rpx;
  right: 26%;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e11d48;
}
.relative-box { position: relative; }
.dot-big { top: -6rpx; right: -8rpx; }

/* 签到/花名册行图标 */
.live-sign-icon { font-size: 40rpx; }

/* 复用首页「进入课堂」按钮样式（home.wxss 里同名 class 只作用于首页，这里自带一份） */
.btn-live {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #fff;
  background: var(--brand-600, #0d9488);
  border-radius: 999rpx;
}
.btn-live-done { background: #94a3b8; }

/* 花名册表格 */
.roster-card { padding: 8rpx 24rpx; }
.roster-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line, #f0f0f0);
  font-size: 26rpx;
}
.roster-row:last-child { border-bottom: none; }
.roster-head { color: var(--muted, #64748b); font-size: 24rpx; }
.roster-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.roster-col { width: 120rpx; text-align: center; }
.roster-col.pos { color: var(--brand-600, #0d9488); font-weight: 600; }
.roster-col.warn { color: #e11d48; font-weight: 600; }
.roster-empty { padding: 24rpx 0; }
.center { text-align: center; }
.mb8 { margin-bottom: 8rpx; }
.mt16 { margin-top: 16rpx; }

/* 底部弹层（签到方式 / 手势） */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title { text-align: center; font-weight: 700; margin-bottom: 20rpx; }
.sheet-way {
  padding: 26rpx 8rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--line, #f0f0f0);
}
.sheet-way:last-of-type { border-bottom: none; }
.sheet-cancel {
  margin-top: 16rpx;
  text-align: center;
  padding: 20rpx 0;
  color: var(--muted, #64748b);
  border-top: 1rpx solid var(--line, #f0f0f0);
}

/* 手势九宫格 */
.gesture-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  padding: 16rpx 32rpx 28rpx;
}
.gesture-dot {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f5f9;
  color: var(--muted, #64748b);
  font-weight: 700;
}
.gesture-dot.on { background: var(--brand-600, #0d9488); color: #fff; }

/* 通用主/次按钮（测试 tab） */
.btn-primary {
  text-align: center;
  padding: 20rpx 0;
  color: #fff;
  background: var(--brand-600, #0d9488);
  border-radius: 14rpx;
  font-weight: 600;
}
.btn-primary.btn-disabled { background: #94a3b8; }
.btn-ghost {
  padding: 16rpx 32rpx;
  border: 1rpx solid var(--line, #e2e8f0);
  border-radius: 999rpx;
  color: var(--muted, #64748b);
  font-size: 26rpx;
}
