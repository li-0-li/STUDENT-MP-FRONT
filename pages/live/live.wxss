/* 课堂参与 —— 状态卡 / 投屏观看区 / 互动区；.card/.pilltabs/.btn 等见 app.wxss */

/* ① 进行中课堂渐变卡 */
.hero {
  background: linear-gradient(135deg, var(--brand-600), var(--brand-700));
  border: none;
  color: #fff;
}
.hero-title { font-size: 30rpx; font-weight: 700; color: #fff; }
.hero-badge {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.hero-sub { color: var(--brand-100); }
.hero-cells { gap: 16rpx; }
.hero-cell {
  flex: 1;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}
.hero-strong { color: #fff; font-weight: 700; }

/* ② 投屏观看区（原型：16:9 深色占位画面 + 控制条） */
.screen-card {
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid var(--border);
  background: #fff;
}
.screen-view {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 56.25%; /* 16:9 */
  background: linear-gradient(135deg, #0f172a, #1e293b);
  color: #fff;
}
/* 居中内容层（绝对定位铺满，padding-bottom 撑高） */
.screen-center {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.screen-icon { font-size: 96rpx; opacity: 0.4; }
.screen-strong { font-size: 28rpx; font-weight: 700; margin-top: 12rpx; opacity: 0.85; }
.screen-sub { opacity: 0.6; margin-top: 4rpx; }
/* 左上角标签组 */
.screen-tags {
  position: absolute;
  top: 16rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 2;
}
.live-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(220, 38, 38, 0.9);
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
  animation: pulse 1.4s infinite;
}
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
.screen-chip {
  background: rgba(15, 23, 42, 0.55);
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}
.screen-latency {
  position: absolute;
  top: 18rpx;
  right: 20rpx;
  font-size: 20rpx;
  opacity: 0.7;
  z-index: 2;
}
/* 控制条 */
.screen-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid var(--border);
  background: #fff;
}
.screen-viewers { flex: 1; color: var(--ink-600); }

/* 互动 tab 通栏 */
.act-tabs { margin: 0 24rpx; width: auto; }
.act-tabs .pill { flex: 1; }
.strong { font-weight: 600; }

/* 弹幕区 */
.danmu-list { padding: 12rpx 24rpx; }
.danmu-item { padding: 12rpx 0; border-bottom: 1rpx dashed var(--border); }
.danmu-item:last-child { border-bottom: none; }
.danmu-name { color: var(--brand-600); font-weight: 600; }
.danmu-foot { margin: 0 24rpx; }
.danmu-foot .input { flex: 1; }

/* 抢答卡 */
.act-holder { flex-direction: column; padding: 48rpx 32rpx; gap: 8rpx; }
.race-btn {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: var(--brand-600);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}
.race-btn.race-done { background: var(--bg-soft); color: var(--ink-600); font-size: 34rpx; }
.race-score { color: var(--brand-600); font-weight: 700; }

/* 提问输入 */
.qa-input { width: 100%; min-height: 140rpx; box-sizing: border-box; }

/* 分隔线 / 课堂测试选项 */
.divider { height: 1rpx; background: var(--border); margin: 16rpx 0; }
.quiz-options { margin-top: 16rpx; display: flex; flex-direction: column; gap: 16rpx; }
.quiz-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
}
.quiz-opt.picked { border-color: var(--brand-600); background: #f0fdfa; }
.quiz-radio {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 3rpx solid var(--ink-400);
  box-sizing: border-box;
  flex: none;
}
.quiz-radio.on { border: 9rpx solid var(--brand-600); }
