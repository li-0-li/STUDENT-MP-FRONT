<!-- 实时课堂：进入时按选课解析当前进行中的课堂；教师未开课显示空态 -->
<view class="page">

  <!-- 空态：当前没有进行中的课堂 -->
  <block wx:if="{{noClass}}">
    <view class="card center empty">
      <view class="empty-icon">📺</view>
      <view class="strong">当前没有进行中的课堂</view>
      <view class="small muted mt8">教师开课后，再次点击「上课入口」即可进入</view>
    </view>
  </block>

  <block wx:else>

  <!-- 实时语音条（2026-11-20，LiveKit RTMP 桥）：收听教师语音 + 开麦发言 -->
  <view class="card audio-bar">
    <view class="between">
      <view class="audio-state {{audioState === 'listening' ? 'ok' : audioState === 'offline' ? 'off' : 'wait'}}">
        <view class="audio-dot"></view>
        <text class="small">{{audioState === 'listening' ? (audioMicOn ? '语音已连接 · 正在发言' : '收听教师语音中') : audioState === 'offline' ? '仅同步课件' : '连接语音中…'}}</text>
      </view>
      <!-- 2026-11-24 上行与下行解耦：收听失败(offline)不再禁用开麦，仅教师禁言时禁用 -->
      <view class="audio-mic-btn {{audioMicOn ? 'on' : ''}} {{audioMuted ? 'disabled' : ''}}" bindtap="toggleMic">
        {{audioMuted ? '已被禁言' : (audioMicOn ? '闭麦' : '开麦')}}
      </view>
    </view>
  </view>

  <!-- 课堂状态卡 -->
  <view class="card">
    <view class="between">
      <view>
        <view class="strong">{{current.course || '加载中…'}}</view>
        <view class="small muted mt4">{{current.week}} · {{current.section}} · {{current.room}}</view>
        <view class="small muted mt4">教师：{{current.teacher}} · {{current.stage}}</view>
      </view>
      <view class="online-box">
        <view class="online-num">{{current.online}}</view>
        <view class="small muted">在线人数 · 已签 {{current.signed}}/{{current.should}}</view>
      </view>
    </view>
  </view>

  <!-- 导航：课堂 | 随堂测试 -->
  <!-- 实时画布（2026-11-16）：教师端课件笔迹实时同步（搬运自学生PC舞台链路；帧已到本页 WS，这里补渲染） -->
  <view class="card stage-card" wx:if="{{!noClass}}">
    <view class="between">
      <view class="strong" style="font-size:28rpx;">实时画布</view>
      <view class="stage-head-right">
        <view class="small muted" wx:if="{{!stageEmpty}}">{{stageName}}<text wx:if="{{stageTotal && stageKind !== 'video' && stageKind !== 'native'}}"> · 第 {{stagePage}}/{{stageTotal}} 页</text></view>
        <!-- 全屏切换（2026-11-20 修复可见性）：放标题行、不依赖画布 hidden 容器——
             absolute 按钮叠在 canvas 上，部分真机同层渲染未生效时被原生组件盖住不可见不可点 -->
        <view wx:if="{{!stageEmpty && stageKind !== 'video' && stageKind !== 'native'}}" class="btn-stage-full" bindtap="toggleStageFull">全屏</view>
      </view>
    </view>
    <!-- canvas 常驻（2026-11-18 修复）：不再用 wx:if 销毁重建——此前 stageEmpty 初始为 true 时
         initCanvas 查不到节点、ctx 永不建立，slide 帧把 stageEmpty 翻 false 后节点才插入但无人重查，
         导致笔迹帧到达却画不出来。改 hidden 控制显隐，节点始终可查询。 -->
    <view class="stage-wrap" hidden="{{stageEmpty || stageKind === 'video' || stageKind === 'native'}}">
      <canvas type="2d" id="stageCanvas" class="stage-canvas"></canvas>
    </view>
    <!-- 视频课件（2026-11-18 多类型）：画布内直接播放，教师切换视频课件时自动跟随 -->
    <view class="stage-media" wx:if="{{stageKind === 'video'}}">
      <video src="{{stageFileUrl}}" class="stage-video" controls object-fit="contain"></video>
    </view>
    <!-- 原生文档课件（doc/docx/xls 等，2026-11-18 多类型）：画布不渲染页面，下载后 openDocument 预览 -->
    <view class="stage-doc-card" wx:if="{{stageKind === 'native'}}">
      <view class="stage-doc-icon">📄</view>
      <view class="small">{{stageFileName || '文档文件'}}</view>
      <view class="small muted">该格式暂不在画布内渲染页面，可打开原生预览</view>
      <view class="btn btn-primary btn-sm" bindtap="openStageDoc">打开文件预览</view>
    </view>
    <view wx:if="{{stageEmpty}}" class="center small muted" style="padding:30rpx 0;">教师尚未展示课件内容</view>
    <!-- 页图加载失败提示（2026-11-20）：替代静默白底；教师翻页/重进课堂会自动重试加载 -->
    <view wx:if="{{!stageEmpty && stageLoadFail}}" class="stage-fail-hint">
      <view>课件页图加载失败</view>
      <view class="small muted">请等待教师翻页自动重试，或下拉刷新重新进入</view>
    </view>
  </view>

  <!-- 全屏画布覆盖层（2026-11-18）：fixed 铺满 + 独立 canvas 节点，进入时全量重绘、增量帧双画布同步 -->
  <view class="stage-full" wx:if="{{stageFull}}" catchtouchmove="noop">
    <view class="stage-full-bar">
      <view class="stage-full-title">{{stageName}}<text wx:if="{{stageTotal}}"> · 第 {{stagePage}}/{{stageTotal}} 页</text></view>
      <view class="stage-full-exit" bindtap="toggleStageFull">退出全屏</view>
    </view>
    <view class="stage-full-wrap">
      <canvas type="2d" id="stageCanvasFull" class="stage-full-canvas"></canvas>
    </view>
  </view>

  <view class="live-nav card">
    <view class="live-nav-item {{tab === 'class' ? 'on' : ''}}" bindtap="switchTab" data-tab="class">课堂</view>
    <view class="live-nav-item {{tab === 'chat' ? 'on' : ''}}" bindtap="switchTab" data-tab="chat">聊天</view>
    <view class="live-nav-item {{tab === 'quiz' ? 'on' : ''}}" bindtap="switchTab" data-tab="quiz">
      随堂测试
      <view wx:if="{{quizDot}}" class="dot"></view>
    </view>
  </view>

  <!-- ============ 课堂 tab ============ -->
  <block wx:if="{{tab === 'class'}}">

    <!-- 签到按钮（教师发布签到时显红点） -->
    <view class="card" bindtap="tapSignin">
      <view class="between">
        <view class="row" style="gap:12rpx">
          <text class="live-sign-icon">✍️</text>
          <view>
            <view class="strong">课堂签到</view>
            <view class="small muted mt4">{{signed ? '已完成 · ' + signedTime : '点击查看教师发布的签到方式'}}</view>
          </view>
        </view>
        <view class="relative-box">
          <view class="btn-live {{signed ? 'btn-live-done' : ''}}">{{signed ? '已签到' : '签到'}}</view>
          <view wx:if="{{signinDot}}" class="dot dot-big"></view>
        </view>
      </view>
    </view>

    <!-- 花名册（本课程全部同学，只读；10s 轮询自动刷新） -->
    <view class="card" bindtap="toggleRoster">
      <view class="between">
        <view class="row" style="gap:12rpx">
          <text class="live-sign-icon">📋</text>
          <view>
            <view class="strong">花名册</view>
            <view class="small muted mt4">本课程全部同学 · 表现分 / 迟到 / 旷课</view>
          </view>
        </view>
        <view class="small muted">{{rosterShow ? '收起 ▲' : '展开 ▼'}}</view>
      </view>
    </view>
    <view wx:if="{{rosterShow}}" class="card roster-card">
      <view class="roster-row roster-head">
        <text class="roster-name">学生名称</text>
        <text class="roster-col">表现分</text>
        <text class="roster-col">迟到</text>
        <text class="roster-col">旷课</text>
      </view>
      <view wx:for="{{roster}}" wx:key="studentId" class="roster-row">
        <text class="roster-name">{{item.name}}</text>
        <text class="roster-col {{item.perfScore > 0 ? 'pos' : ''}}">{{item.perfScore}}</text>
        <text class="roster-col {{item.lateCount > 0 ? 'warn' : ''}}">{{item.lateCount}}</text>
        <text class="roster-col {{item.absentCount > 0 ? 'warn' : ''}}">{{item.absentCount}}</text>
      </view>
      <view wx:if="{{!roster.length}}" class="small muted center roster-empty">花名册加载中…</view>
    </view>
  </block>

  <!-- ============ 随堂测试 tab ============ -->
  <block wx:if="{{tab === 'quiz'}}">
    <!-- 有测试 -->
    <view wx:if="{{quiz.quizId && !quiz.submitted}}" class="card">
      <view class="strong">{{quiz.title || '随堂测试'}}</view>
      <view class="small muted mt4">共 {{quiz.total}} 题</view>
      <view class="small muted mt4">截止时间：{{quiz.deadline}}</view>
      <view wx:if="{{quiz.active}}" class="btn-primary mt16" bindtap="goQuiz">开始测试</view>
      <view wx:else class="btn-primary mt16 btn-disabled">已截止，无法作答</view>
    </view>
    <!-- 已提交：直达本次答题情况 -->
    <view wx:elif="{{quiz.quizId && quiz.submitted}}" class="card">
      <view class="strong">{{quiz.title || '随堂测试'}}</view>
      <view class="small muted mt4">你已提交 · 做对 {{quiz.correctCount}}/{{quiz.total}} 题</view>
      <view class="btn-primary mt16" bindtap="goQuizResult">查看本次答题情况</view>
    </view>
    <!-- 未发布：空态 + 历史测试 -->
    <view wx:else class="card center empty">
      <view class="empty-icon">📝</view>
      <view class="small muted">教师还未发布任何测试</view>
      <view class="quiz-history-link" bindtap="goQuizHistory">查看历史测试 ›</view>
    </view>
  </block>

  <!-- ============ 聊天 tab（2026-11-20 在线互动：课堂聊天，口径对齐学生端 PC） ============ -->
  <block wx:if="{{tab === 'chat'}}">
    <view class="card chat-card">
      <scroll-view class="chat-list" scroll-y scroll-into-view="{{chatScrollInto}}" scroll-with-animation>
        <view wx:if="{{!messages.length}}" class="small muted center chat-empty">还没有消息，说点什么吧</view>
        <view wx:for="{{messages}}" wx:key="messageId" id="msg-{{item.messageId}}"
          class="chat-row {{item.mine ? 'mine' : ''}}">
          <view class="chat-meta">{{item.senderName}} · {{item.timeShort}}</view>
          <!-- 历史语音消息占位（2026-11-20 录音功能已移除，仅兼容显示不裂版） -->
          <view wx:if="{{item.msgType === 'voice'}}" class="chat-bubble voice-placeholder {{item.mine ? 'bubble-mine' : 'bubble-other'}}">[语音消息 {{item.duration || 1}}″]</view>
          <view wx:else class="chat-bubble {{item.mine ? 'bubble-mine' : 'bubble-other'}}">{{item.content}}</view>
        </view>
      </scroll-view>
      <view class="chat-input-bar">
        <input class="chat-input" value="{{chatInput}}" placeholder="说点什么…" maxlength="500"
          confirm-type="send" bindinput="onChatInput" bindconfirm="sendChat" />
        <view class="chat-send {{chatInput ? '' : 'off'}}" bindtap="sendChat">发送</view>
      </view>
    </view>
  </block>

  <!-- 签到方式面板（教师发布后弹出） -->
  <view wx:if="{{signinPanel}}" class="mask" bindtap="closeSigninPanel">
    <view class="sheet" catchtap="">
      <view class="sheet-title">选择签到方式</view>
      <view wx:for="{{signinWays}}" wx:key="key" class="sheet-way" bindtap="chooseWay" data-key="{{item.key}}">
        {{item.label}} >
      </view>
      <view class="sheet-cancel" bindtap="closeSigninPanel">取消</view>
    </view>
  </view>

  <!-- 手势签到面板：九宫格按序点亮 -->
  <view wx:if="{{gestureShow}}" class="mask" bindtap="closeSigninPanel">
    <view class="sheet" catchtap="">
      <view class="sheet-title">手势签到</view>
      <view class="small muted center mb8">按教师展示的手势，依次点亮点位（{{gestureDots.length}} 点）</view>
      <view class="gesture-grid">
        <view wx:for="{{[1,2,3,4,5,6,7,8,9]}}" wx:key="*this"
          class="gesture-dot {{gestureDots.indexOf(item) >= 0 ? 'on' : ''}}"
          bindtap="tapGestureDot" data-n="{{item}}">{{item}}</view>
      </view>
      <view class="row center" style="gap:24rpx;justify-content:center">
        <view class="btn-ghost" bindtap="undoGesture">回退</view>
        <view class="btn-ghost" bindtap="clearGesture">重画</view>
        <view class="btn-primary" bindtap="submitGesture">提交手势</view>
      </view>
    </view>
  </view>

  </block>

  <!-- 实时语音流组件（2026-11-20，LiveKit RTMP 桥）：纯音频，透明收纳在页面底部，仅真机生效 -->
  <live-player wx:if="{{audioPullUrl}}" id="audioPlayer" src="{{audioPullUrl}}" mode="live"
    autoplay muted="{{false}}" orientation="vertical" object-fit="fill"
    class="audio-player" bindstatechange="onAudioPlayerState"></live-player>
  <live-pusher wx:if="{{audioPushUrl}}" src="{{audioPushUrl}}" mode="live" autopush
    enable-camera="{{false}}" enable-mic="{{true}}" enable-agc="{{true}}" enable-ans="{{true}}"
    class="audio-pusher" bindstatechange="onAudioPusherState"></live-pusher>

</view>
