<!-- 实时课堂（2026-10-29 改版）：课堂 | 随堂测试 双导航；无投屏/直播/互动 -->
<view class="page">

  <!-- 课堂状态卡 -->
  <view class="card">
    <view class="between">
      <view>
        <view class="strong">{{current.course || '加载中…'}}</view>
        <view class="small muted mt4">{{current.week}} · {{current.section}} · {{current.room}}</view>
        <view class="small muted mt4">教师：{{current.teacher}} · {{current.stage}}</view>
      </view>
      <view class="online-box">
        <view class="online-num">{{current.online}}</view>
        <view class="small muted">在线人数</view>
      </view>
    </view>
  </view>

  <!-- 导航：课堂 | 随堂测试 -->
  <view class="live-nav card">
    <view class="live-nav-item {{tab === 'class' ? 'on' : ''}}" bindtap="switchTab" data-tab="class">课堂</view>
    <view class="live-nav-item {{tab === 'quiz' ? 'on' : ''}}" bindtap="switchTab" data-tab="quiz">
      随堂测试
      <view wx:if="{{quizDot}}" class="dot"></view>
    </view>
  </view>

  <!-- ============ 课堂 tab ============ -->
  <block wx:if="{{tab === 'class'}}">

    <!-- 签到按钮（教师发布签到时显红点） -->
    <view class="card" bindtap="tapSignin">
      <view class="between">
        <view class="row" style="gap:12rpx">
          <text class="live-sign-icon">✍️</text>
          <view>
            <view class="strong">课堂签到</view>
            <view class="small muted mt4">{{signed ? '已完成 · ' + signedTime : '点击查看教师发布的签到方式'}}</view>
          </view>
        </view>
        <view class="relative-box">
          <view class="btn-live {{signed ? 'btn-live-done' : ''}}">{{signed ? '已签到' : '签到'}}</view>
          <view wx:if="{{signinDot}}" class="dot dot-big"></view>
        </view>
      </view>
    </view>

    <!-- 花名册（本课程全部同学，只读；10s 轮询自动刷新） -->
    <view class="card" bindtap="toggleRoster">
      <view class="between">
        <view class="row" style="gap:12rpx">
          <text class="live-sign-icon">📋</text>
          <view>
            <view class="strong">花名册</view>
            <view class="small muted mt4">本课程全部同学 · 表现分 / 迟到 / 旷课</view>
          </view>
        </view>
        <view class="small muted">{{rosterShow ? '收起 ▲' : '展开 ▼'}}</view>
      </view>
    </view>
    <view wx:if="{{rosterShow}}" class="card roster-card">
      <view class="roster-row roster-head">
        <text class="roster-name">学生名称</text>
        <text class="roster-col">表现分</text>
        <text class="roster-col">迟到</text>
        <text class="roster-col">旷课</text>
      </view>
      <view wx:for="{{roster}}" wx:key="studentId" class="roster-row">
        <text class="roster-name">{{item.name}}</text>
        <text class="roster-col {{item.perfScore > 0 ? 'pos' : ''}}">{{item.perfScore}}</text>
        <text class="roster-col {{item.lateCount > 0 ? 'warn' : ''}}">{{item.lateCount}}</text>
        <text class="roster-col {{item.absentCount > 0 ? 'warn' : ''}}">{{item.absentCount}}</text>
      </view>
      <view wx:if="{{!roster.length}}" class="small muted center roster-empty">花名册加载中…</view>
    </view>
  </block>

  <!-- ============ 随堂测试 tab ============ -->
  <block wx:if="{{tab === 'quiz'}}">
    <!-- 有测试 -->
    <view wx:if="{{quiz.quizId && !quiz.submitted}}" class="card">
      <view class="strong">{{quiz.title || '随堂测试'}}</view>
      <view class="small muted mt4">共 {{quiz.total}} 题</view>
      <view class="small muted mt4">截止时间：{{quiz.deadline}}</view>
      <view wx:if="{{quiz.active}}" class="btn-primary mt16" bindtap="goQuiz">开始测试</view>
      <view wx:else class="btn-primary mt16 btn-disabled">已截止，无法作答</view>
    </view>
    <!-- 已提交：直达本次答题情况 -->
    <view wx:elif="{{quiz.quizId && quiz.submitted}}" class="card">
      <view class="strong">{{quiz.title || '随堂测试'}}</view>
      <view class="small muted mt4">你已提交 · 做对 {{quiz.correctCount}}/{{quiz.total}} 题</view>
      <view class="btn-primary mt16" bindtap="goQuizResult">查看本次答题情况</view>
    </view>
    <!-- 未发布：空态 + 历史测试 -->
    <view wx:else class="card center empty">
      <view class="empty-icon">📝</view>
      <view class="small muted">教师还未发布任何测试</view>
      <view class="btn-primary mt16" bindtap="goQuizHistory">查看历史测试</view>
    </view>
  </block>

  <!-- 签到方式面板（教师发布后弹出） -->
  <view wx:if="{{signinPanel}}" class="mask" bindtap="closeSigninPanel">
    <view class="sheet" catchtap="">
      <view class="sheet-title">选择签到方式</view>
      <view wx:for="{{signinWays}}" wx:key="key" class="sheet-way" bindtap="chooseWay" data-key="{{item.key}}">
        {{item.label}} >
      </view>
      <view class="sheet-cancel" bindtap="closeSigninPanel">取消</view>
    </view>
  </view>

  <!-- 手势签到面板：九宫格按序点亮 -->
  <view wx:if="{{gestureShow}}" class="mask" bindtap="closeSigninPanel">
    <view class="sheet" catchtap="">
      <view class="sheet-title">手势签到</view>
      <view class="small muted center mb8">按教师展示的手势，依次点亮点位（{{gestureDots.length}} 点）</view>
      <view class="gesture-grid">
        <view wx:for="{{[1,2,3,4,5,6,7,8,9]}}" wx:key="*this"
          class="gesture-dot {{gestureDots.indexOf(item) >= 0 ? 'on' : ''}}"
          bindtap="tapGestureDot" data-n="{{item}}">{{item}}</view>
      </view>
      <view class="row center" style="gap:24rpx;justify-content:center">
        <view class="btn-ghost" bindtap="undoGesture">回退</view>
        <view class="btn-ghost" bindtap="clearGesture">重画</view>
        <view class="btn-primary" bindtap="submitGesture">提交手势</view>
      </view>
    </view>
  </view>

</view>
